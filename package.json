{
  "name": "bookinghub-api",
  "version": "1.0.0",
  "description": "Tenant-isolated booking API for Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "db:migrate": "wrangler d1 migrations apply bookinghub --local",
    "db:migrate:remote": "wrangler d1 migrations apply bookinghub --remote",
    "db:generate": "drizzle-kit generate",
    "admin": "node --import tsx scripts/admin.ts",
    "openapi": "node --import tsx scripts/export-openapi.ts",
    "deploy": "wrangler deploy",
    "smoke:local": "node --import tsx scripts/smoke-local.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
